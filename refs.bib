	volume = {11},
	number = {4},
	pages = {684 - 696},
	doi = {10.1016/j.aaf.2025.11.008},
	url = {https://www.scopus.com/pages/publications/105027266700?origin=resultslist},
	abstract = {Integrating Contrast Colour Correction (CACC) and Convolutional Neural Networks (CNN) can help fish breeders in earlier classification and identification of Cryptocaryon fish disease (protozoan white spot disease). Disease identification accuracy is enhanced through such method by adaptive colour changes and CNN feature extracting ability, thereby boosting underwater image clarity. Unlike traditional rule-based systems that relies on expert knowledge despite being error-prone, existing methods focus on visual quality without classifying impact influence. Early disease identification is hampered in terms of efficiency due to machine learning methods reliant on abundant human expertise other than efficient feature extracting. An artificial intelligence (AI)-oriented computer model is introduced for existing research in overcoming limitations and eliminating subjectivity. The model employs a proprietary method of diagnosing fish disease through underwater images examination that yields objective outcome. Several CNN structures such as GoogleNet, ResNet-101, AlexNet, ResNet-50 as well as VGG-16 are tested on its performance. The current study shows integration of CACC with CNN through a set of 15000 images boosting up model performance in Cryptocaryon fish disease detection. The introduced novel method significantly enhances performance with 99.53% accuracy, 99.08% precision along with 100.00% recall. This efficient, accurate approach can significantly reduce the workload of experts and fish farmers while promoting sustainable aquaculture and healthier aquatic ecosystems. © 2025 Shanghai Ocean University}
}

@ARTICLE{Olsen2026,
	author = {Olsen, Agnethe S. and Rosin, Paul L. and Jones, Christopher B. and Cable, Jo and Perkins, Sarah E.},
	title = {Computer vision for infectious disease surveillance; Saprolegnia spp. in salmonids},
	year = {2026},
	journal = {Ecological Informatics},
	volume = {93},
	pages = {},
	doi = {10.1016/j.ecoinf.2025.103567},
	url = {https://www.scopus.com/pages/publications/105028030546?origin=resultslist},
	abstract = {Effective disease surveillance in wild fish populations is essential for food security and biodiversity conservation, but data acquisition can be limited by ad hoc reporting and resource-intensive laboratory diagnostics. We developed and evaluated a computer vision pipeline to detect saprolegniasis-like infections, a devastating disease in salmonids that manifests as visible signs. Compiling a dataset of 4526 images (494 infected, 4032 healthy) from citizen science platforms and stakeholders, we used data augmentation to address the significant class imbalance. We then fine-tuned and compared four pre-trained convolutional neural network architectures (EfficientNetV2S, EfficientNetV2B0, ResNet50, and MobileNetV3S), chosen to represent a range of standard and efficient models, to classify healthy versus infected fish across datasets of varying host taxonomic specificity. The EfficientNetV2S model achieved the highest performance on a Salmo spp. specific dataset, with a mean recall (proportion of infected fish images correctly identified) of 0.898 (± 0.043) and precision (proportion of correctly identified infected fish among all fish identified as infected) of 0.858 (± 0.067). Performance varied with host taxonomic scope, with models achieving lower metrics on broader host taxa datasets. Despite challenges including variable image quality, water surface reflections, and inherent class imbalance, these results show computer vision can support large-scale disease surveillance in wild fish populations. Computer vision-based surveillance could enable earlier outbreak detection and targeted diagnostics, improving freshwater ecosystem health management. While successful implementation hinges on acquiring sufficient high-quality imagery, this study highlights the potential of applying tailored Artificial Intelligence tools for monitoring visually detectable diseases across diverse wildlife species. © 2025 The Authors.}
}

@ARTICLE{N.S.2026,
	author = {N.S., Abinaya and R., Rajalakshmi and Sidharthan, Rakesh Kumar},
	title = {Trustworthy AI framework for Salmon disease detection using replay-enhanced selective network with incremental learning},
	year = {2026},
	journal = {Aquaculture},
	volume = {613},
	pages = {},
	doi = {10.1016/j.aquaculture.2025.743438},
	url = {https://www.scopus.com/pages/publications/105022201637?origin=resultslist},
	abstract = {Trustworthiness is a critical requirement in Artificial Intelligence (AI)-based fish disease detection systems, especially in real-world aquaculture applications. The proposed work utilizes a customized selective network architecture that enables the model to avoid uncertain classifications, thereby enhancing reliability. The architecture consists of two heads: a classification head for disease identification and a selection head for abstention from unreliable classifications. Salmon Scan fish disease image set is considered in this work. Agentic AI-based inlier and outlier generation is formulated to augment the existing image set for selective network training. Commonly encountered artifacts, such as hand occlusions, motion blur, and flashing effects during high-throughput scanning, are synthetically generated and used as outliers to improve robustness. Selective network is enhanced with a replay image set using the Elastic Weight Consolidation (EWC) technique to mitigate catastrophic forgetting and support incremental learning. Replay-image set is created using rejected images with expert-in-the-loop, enhancing the accuracy of the proposed system. Hence, a trustworthy AI system is achieved by combining a selective network for reliability with replay enhancement to improve accuracy. Experimental results demonstrate classification and selection accuracies of approximately 98 % and 97 %, respectively, after replay enhancement. It also leads to a positive backward transfer of ∼2 % on average, enhancing the learning and trustworthiness of the proposed AI-based disease classification system. © 2025 Elsevier B.V.}
}

@ARTICLE{Canepa2026,
	author = {Canepa, Maximiliano M. and Amoroso, Gianluca and Rands, Lewis and Carter, Chris G.},
	title = {Size matters with respect to the effects of suboptimum summer conditions on Atlantic salmon production},
	year = {2026},
	journal = {Aquaculture},
	volume = {612},
	pages = {},
	doi = {10.1016/j.aquaculture.2025.743191},
	url = {https://www.scopus.com/pages/publications/105016805171?origin=resultslist},
	abstract = {Aquaculture of Tasmanian Atlantic salmon occurs in a geographical area where water temperatures occasionally approach the upper thermal tolerance of the species and where climate change effects are ahead of global trends. This represents a concern for the local producers as well as being of global interest, particularly in the context of evolving aquaculture practices. In this study, we investigated the impact of long-term suboptimum conditions on seawater production characteristics of both small (Experiment 1; ∼420 g average size) and large (Experiment 2; ∼2600 g) Atlantic salmon from the same breeding cohort and genetic lines (∼170 families). Each experiment was undertaken in recirculating aquaculture systems and consisted of three periods: 14 days of acclimation (15 °C and 100 % dissolved oxygen -DO-); 67–72 days of exposure to suboptimum conditions (19 °C and 80 % DO); and a 40–42 day recovery period (15 °C and 100 % DO). All fish were PIT-tagged and individually measured at the pre-acclimation, post-suboptimum conditions, and post-recovery at the end of the experiment. Feed intake decreased during exposure to suboptimum conditions in both fish sizes but recovered during the recovery period. There were significant differences in specific growth rate, feed conversion ratio and condition factor due to experimental conditions and fish size. Machine learning analyses identified a significantly greater impact of long-term exposure to suboptimum conditions on large fish as compared to small individuals. The translational approach used in this study improves our understanding of the effects of suboptimum summer conditions on Atlantic salmon and provides insights on practical size-based mitigation strategies and a baseline to produce predictive models. © 2025}
}

@ARTICLE{Fulton2026,
	author = {Fulton, Lawrence and Lyu, Pin},
	title = {Integrating biological and machine learning models for rainbow trout growth: Balancing accuracy and interpretability},
	year = {2026},
	journal = {PLOS ONE},
	volume = {21},
	number = {3 March},
	pages = {},
	doi = {10.1371/journal.pone.0336890},
	url = {https://www.scopus.com/pages/publications/105033636118?origin=resultslist},
	abstract = {Invasive species management demands predictive models that balance accuracy with ecological interpretability, yet traditional approaches often fail to capture complex environmental interactions. We evaluated hybrid frameworks integrating biological and machine learning models for rainbow trout (Oncorhynchus mykiss) growth in the Lower Colorado River using ten years of tag–recapture data and environmental covariates, comparing traditional and Bayesian von Bertalanffy (VBGM) and Gompertz models with Random Forests, XGBoost, LightGBM, Support Vector Regression, Neural Networks, and ensemble methods through probabilistic performance analysis. Incorporating environmental context and advanced modeling produced substantial gains, with top methods achieving 70–80 percent error reductions relative to baseline models, equivalent to 45–70 mm or 20–32 percent of mean fish length. A stacked ensemble of XGBoost and the VBGM achieved the best performance (RMSE=15.96 mm, R<sup>2</sup> = 0.966) and exhibited stochastic dominance across the posterior, while gradient boosting models formed a strong second tier, led by LightGBM and XGBoost. Bayesian Model Averaging reached comparable accuracy while explicitly quantifying uncertainty. Even traditional mechanistic models improved by up to 80 percent when enhanced with covariates and Bayesian estimation, preserving biological interpretability through parameters such as asymptotic size and growth rate. Feature importance analysis identified initial length, time at large, and weight at release as dominant predictors, and the stacked ensemble outperformed baseline models in over 99 percent of posterior samples. These results establish hybrid ensemble frameworks as powerful tools for ecological forecasting that unite predictive performance with mechanistic insight, providing a generalizable template for systems where both accuracy and interpretability are required. © 2026 Fulton, Lyu. This is an open access article distributed under the terms of the Creative Commons Attribution License, which permits unrestricted use, distribution, and reproduction in any medium, provided the original author and source are credited.}
}

@ARTICLE{Andy Prastyabudi2026,
	author = {Andy Prastyabudi, Wahyu and Deng Solvang, Wei},
	title = {A data-driven predictive modelling of delousing treatment events in Norwegian salmon farming using machine learning},
	year = {2026},
	journal = {Results in Engineering},
	volume = {30},
	pages = {},
	doi = {10.1016/j.rineng.2026.110736},
	url = {https://www.scopus.com/pages/publications/105037932634?origin=resultslist},
	abstract = {Controlling salmon sea lice has been challenging due to the dynamic nature of the environment, fish welfare issues, and operational costs, highlighting the importance of proactive delousing strategies for the timely management of operations. This paper presents the development of data-driven machine learning (ML) models aimed at predicting delousing treatment events in Norwegian salmon aquaculture, formulating the task as a binary classification problem. Seven different ML models were developed and evaluated using an integrated dataset from 2020 to 2024. The dataset, collected from multiple sources, includes site production data, fish health records, and environmental conditions. A spatial-temporal analysis was conducted to examine treatment patterns across production areas. The ML models were implemented on a cloud-based platform and validated using a time-aware cross-validation approach. In addition, various sampling strategies were investigated to handle class imbalance during the training phase. The prediction results were evaluated using the average precision (AP) and AP lift metrics. SMOTE (SM) emerged as the best-performing resampling approach, leading to improved predictive performance across the ML models. The model’s performance hinged on the sampling strategies, spatial-temporal contexts, and dataset size. The pairwise comparison on the AP lift scores indicated that ensemble models showed comparable performance. Among the tested ML models, eXtreme Gradient Boosting (XGB) model achieved the highest performance, with a mean AP lift score of 3.74. © 2026 The Author(s).}
}

@ARTICLE{Szewczyk2026,
	author = {Szewczyk, Tim M. and Aleynik, Dmitry and Reinardy, Helena C. and Last, Kim S. and Dale, Andrew C.},
	title = {Embracing uncertainty: Ensemble models of sea lice larval dispersal},
	year = {2026},
	journal = {Ecological Modelling},
	volume = {519},
	pages = {},
	doi = {10.1016/j.ecolmodel.2026.111651},
	url = {https://www.scopus.com/pages/publications/105038236284?origin=resultslist},
	abstract = {Sea lice, particularly Lepeophtheirus salmonis, pose significant ecological and economic challenges to salmon aquaculture. Dispersal occurs via planktonic larval stages which may spread widely, driven by interacting physical and biological processes. Direct observations are challenging, and biophysical particle tracking models are commonly used to estimate infestation pressure. Nevertheless, there is substantial uncertainty in model parameterization. We assessed ensemble approaches that aim to harness this uncertainty to improve predictions of farm-associated sea lice distributions. Using public data from salmon farms in Scotland (2021–2024) and 20 parameterizations, we compared three ensemble methods: a simple average, a model with spatially varying blending weights, and a machine learning model. Ensemble performance was assessed against that of the constituent parameterizations, all using adult-equivalent infestation pressure (rolling sum of copepodid pressure adjusted for on-fish demographics) to predict the reported mean adult female lice per fish. Cross-validation showed superiority of machine learning ensembles for dynamics on farms, though more direct data on larval concentrations would be required to predict larval infestation pressure. On average, the ensemble model with spatially varying weights outperformed all constituents, particularly for spatial patterns, and predicts ensemble infestation pressure as a latent variable. The simple average ensemble performed better than the median constituent. A resampling experiment confirmed the robustness of these results across constituents and ensemble sizes (3–15). Ensemble modelling is thus a promising pathway toward improving predictions of sea lice infestation pressure, with flexibility to tailor ensembles toward particular goals. Better predictions of sea lice dispersal enable better management of infestations, ultimately improving the welfare and production of farmed fish and reducing lice burdens for wild salmonids. © 2026 The Author(s). Published by Elsevier B.V. This is an open access article under the CC BY license. http://creativecommons.org/licenses/by/4.0/}
}

@ARTICLE{Bui2026,
	author = {Bui, Ngoc Minh Ngan and Props, Ruben and Defoirdt, Tom and Boon, Nico},
	title = {Flow cytometry–based prediction of survival-linked microbial indicators in barramundi larviculture: Early warning via phenotypic fingerprints},
	year = {2026},
	journal = {Aquaculture},
	volume = {618},
	pages = {},
	doi = {10.1016/j.aquaculture.2026.743822},
	url = {https://www.scopus.com/pages/publications/105031419770?origin=resultslist},
	abstract = {Although microbial communities are dynamic and critical for larval health in aquaculture, reliable early-warning tools remain scarce. Here, we combine flow cytometry (FCM) and 16S rRNA gene sequencing to identify microbial indicators that anticipate survival outcomes in barramundi (Lates calcarifer) hatcheries. Sequencing revealed 54 amplicon sequence variants (ASVs) that consistently distinguished high- and low-survival tanks. Machine-learning models trained on 134 FCM phenotypic fingerprints accurately inferred the abundances of selected ASVs and reproduced survival-linked patterns across 20 independent larviculture batches (n = 1206). Four detrimental ASVs – Citrobacter (asv28, asv78), Rhodopseudomonas (asv6), and Arcobacter (asv47) - were predictive of poor survival, with discriminatory signals detectable as early as day 0 post-hatch (DPH 0). Classification models based on these markers at DPH 0 achieved moderate accuracy (AUC ≤ 0.74), indicating that microbial signatures can predict survival trajectories before mortality becomes apparent at DPH 4–5. Importantly, FCM-based classifiers alone also captured sufficient discriminatory information at DPH 0, offering a practical route for rapid, high-throughput monitoring. Overall, our findings establish FCM-sequencing integration as a powerful approach to derive microbial survival markers and enabling proactive management in fish hatcheries. © 2026 Elsevier B.V.}
}

@ARTICLE{Saville2026,
	author = {Saville, Ramadhona and Fujiwara, Atsushi and Hatanaka, Katsumori and Wada, Masaaki and Yaman, Aris and Puspasari, Reny and Albasri, Hatim and Dwiyoga, Nugroho},
	title = {AI-powered decision support system for mariculture: Real-time fish mortality prediction with random forest},
